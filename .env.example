# Server-only commercial API configuration. Never expose these through Rspack/client variables.
NODE_ENV=development
APP_ORIGIN=http://localhost:8090
# Neon Postgres pooled runtime URL from the Vercel Marketplace integration.
DATABASE_URL=postgres://user:password@localhost:5432/chat_demo
# Use a separate direct/admin URL for `pnpm db:migrate` when the provider requires it.
# DATABASE_MIGRATION_URL=postgres://user:password@localhost:5432/chat_demo
AUTH_SECRET=replace-with-at-least-32-random-characters
# Resend is used for verification and password-recovery messages.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Chat Demo <auth@example.com>

# Future provider/billing settings belong here or in the hosting secret manager,
# never in localStorage or a browser bundle.
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
